---
import Background from "../components/Background";
import Character from "../components/Character.astro";
import Clock from "../components/Clock";
import SearchBar from "../components/SearchBar.astro";
import Services from "../components/Services.astro";
import { BACKGROUND_VIDEO_STORAGE_KEY, BACKGROUND_VIDEOS } from "../lib/videos";

import "../styles/global.css";

const noVideoId = BACKGROUND_VIDEOS.find((v) => v.src === null)?.id ?? "_";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Prism Tower</title>
    <script is:inline define:vars={{ storageKey: BACKGROUND_VIDEO_STORAGE_KEY, noVideoId }}>
      try {
        if (localStorage.getItem(storageKey) === noVideoId) {
          document.documentElement.classList.add("no-video");
        }
      } catch {}
    </script>
  </head>
  <body class="relative w-full min-h-screen text-white">
    <Background client:load />
    <div class="relative flex flex-col items-center py-12 px-8 md:px-12 gap-12">
      <Clock client:load />
      <SearchBar />
      <Services />
    </div>
    <Character />
  </body>
</html>
